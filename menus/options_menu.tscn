[gd_scene format=3]

[ext_resource type="Script" path="res://menus/options_menu.gd" id="1_script"]

[node name="OptionsMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.85)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Content" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Center/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 48
text = "Options"
horizontal_alignment = 1

[node name="General" type="GridContainer" parent="Center/Content"]
layout_mode = 2
theme_override_constants/h_separation = 32
columns = 2

[node name="MasterLabel" type="Label" parent="Center/Content/General"]
layout_mode = 2
text = "Volume général"

[node name="MasterSlider" type="HSlider" parent="Center/Content/General"]
unique_name_in_owner = true
custom_minimum_size = Vector2(360, 0)
layout_mode = 2
size_flags_vertical = 4
max_value = 1.0
step = 0.05

[node name="MusicLabel" type="Label" parent="Center/Content/General"]
layout_mode = 2
text = "Musique"

[node name="MusicSlider" type="HSlider" parent="Center/Content/General"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
max_value = 1.0
step = 0.05

[node name="SfxLabel" type="Label" parent="Center/Content/General"]
layout_mode = 2
text = "Effets sonores"

[node name="SfxSlider" type="HSlider" parent="Center/Content/General"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
max_value = 1.0
step = 0.05

[node name="FullscreenLabel" type="Label" parent="Center/Content/General"]
layout_mode = 2
text = "Plein écran"

[node name="FullscreenCheck" type="CheckButton" parent="Center/Content/General"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0

[node name="ControlsTitle" type="Label" parent="Center/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 36
text = "Contrôles (clavier / manette)"
horizontal_alignment = 1

[node name="Controls" type="GridContainer" parent="Center/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 16
columns = 3

[node name="Buttons" type="HBoxContainer" parent="Center/Content"]
layout_mode = 2
theme_override_constants/separation = 16
alignment = 1

[node name="ResetButton" type="Button" parent="Center/Content/Buttons"]
layout_mode = 2
text = "Touches par défaut"

[node name="BackButton" type="Button" parent="Center/Content/Buttons"]
layout_mode = 2
text = "Retour"

[connection signal="toggled" from="Center/Content/General/FullscreenCheck" to="." method="_on_fullscreen_check_toggled"]
[connection signal="pressed" from="Center/Content/Buttons/ResetButton" to="." method="_on_reset_button_pressed"]
[connection signal="pressed" from="Center/Content/Buttons/BackButton" to="." method="_on_back_button_pressed"]
