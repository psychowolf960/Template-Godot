[gd_scene format=3]

[ext_resource type="Script" path="res://menus/end_screen.gd" id="1_script"]

[node name="EndScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.11, 0.12, 0.18, 1)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Content" type="VBoxContainer" parent="Center"]
custom_minimum_size = Vector2(320, 0)
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Center/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 72
text = "Victoire !"
horizontal_alignment = 1

[node name="Score" type="Label" parent="Center/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "Score : 0"
horizontal_alignment = 1

[node name="RetryButton" type="Button" parent="Center/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "Rejouer"

[node name="MainMenuButton" type="Button" parent="Center/Content"]
layout_mode = 2
text = "Menu principal"

[connection signal="pressed" from="Center/Content/RetryButton" to="." method="_on_retry_button_pressed"]
[connection signal="pressed" from="Center/Content/MainMenuButton" to="." method="_on_main_menu_button_pressed"]
